{
  "expo": {
    "name": "homibook",
    "slug": "homibook-mobile",
    "version": "1.1.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homibook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.saaangxy.homibook",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#fdf8ee",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_SMS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "imageWidth": 340,
          "backgroundColor": "#f1f5f9",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#0f172a"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 HomiBook 访问你的相册，用于选择小票/收据图片进行记账",
          "cameraPermission": "允许 HomiBook 使用相机，用于拍摄小票/收据进行记账"
        }
      ],
      "./plugins/with-android-tweaks",
      "./plugins/with-notification-listener",
      "expo-notifications",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*",
            "text/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
