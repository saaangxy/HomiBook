# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# 本地 Expo Module(mobile/modules/*/):源码需提交,只忽略其构建产物。
# 注意上面的 /android、/ios 带前导斜杠只作用于 mobile/ 根级,不会误伤模块源码目录
modules/*/android/build/
modules/*/ios/build/
