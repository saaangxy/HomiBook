# 复制为 .env 后按需修改，docker compose 会自动读取

# ================= 镜像来源 =================
# 默认从 DockerHub 拉取；改用 GitHub Container Registry（内容相同，国内通常更快）时取消下一行注释
# IMAGE_REPO=ghcr.io/saaangxy/homibook
# 固定版本（默认 latest，回滚时可指定 v<版本号>）
# IMAGE_TAG=latest

# 服务端口（容器内部 + 对外访问）
PORT=8080

# 业务时区（IANA 时区名，影响日期统计口径/AI 提示中的当前日期）
TZ=Asia/Shanghai

# JWT 密钥（务必修改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# ================= 数据库配置 =================
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:/app/data/dev.db

# 使用 MySQL（docker compose --profile mysql up -d）:
# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://homibook:homibook@mysql:3306/homibook

# 使用 PostgreSQL（docker compose --profile postgres up -d）:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://homibook:homibook@postgres:5432/homibook
