# 复制为 .env 后按需修改，docker compose 会自动读取

# 服务端口（容器内部 + 对外访问）
PORT=8080

# JWT 密钥（务必修改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# ================= 数据库配置 =================
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:/app/data/dev.db

# 使用 MySQL（docker compose --profile mysql up -d）:
# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://homibook:homibook@mysql:3306/homibook

# 使用 PostgreSQL（docker compose --profile postgres up -d）:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://homibook:homibook@postgres:5432/homibook
