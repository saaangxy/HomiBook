# 复制为 .env 后按需修改，docker compose 会自动读取

# 外部访问前端入口端口（Nginx）
FRONTEND_PORT=8080

# 后端服务端口（容器内部 + 外部暴露）
BACKEND_PORT=3002
BACKEND_EXPOSE_PORT=3002

# JWT 密钥（生产环境务必修改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# ================= 数据库配置 =================
# 数据库类型: sqlite | mysql | postgresql
DATABASE_PROVIDER=sqlite

# sqlite: 文件数据库（推荐，零配置），文件持久化在 homibook-data 卷
DATABASE_URL=file:/app/data/dev.db

# 部署使用 MySQL（先 docker compose --profile mysql up -d）:
# DATABASE_PROVIDER=mysql
# DATABASE_URL=mysql://homibook:homibook@mysql:3306/homibook
# MYSQL_ROOT_PASSWORD=homibook
# MYSQL_DATABASE=homibook
# MYSQL_USER=homibook
# MYSQL_PASSWORD=homibook

# 部署使用 PostgreSQL（先 docker compose --profile postgres up -d）:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://homibook:homibook@postgres:5432/homibook
# POSTGRES_DB=homibook
# POSTGRES_USER=homibook
# POSTGRES_PASSWORD=homibook
