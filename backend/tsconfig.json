{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "composite": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  // 只编译 src/：prisma.config.ts 由 Prisma CLI 执行，dist/ 旧产物不作为输入
  // @homibook/core 类型/运行时经 node_modules(workspace 链接)的 exports 解析到 packages/core/dist
  "include": ["src"]
}