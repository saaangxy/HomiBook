generator client {
  provider      = "prisma-client-js"
  // native = 当前平台（Windows 开发机 / Docker 的 Debian 运行镜像），无需额外目标
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  nickname  String?  @map("name")
  role      String   @default("USER")
  status    String   @default("ACTIVE")
  theme     String   @default("dark")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  ownedBooks           AccountBook[] @relation("BookOwner")
  memberships          AccountBookMember[]
  accounts             Account[]
  records              Record[]
  recurringTransactions RecurringTransaction[]
  apiKeys              ApiKey[]
  chatSessions         ChatSession[]
  memories             UserMemory[]
  auditLogs            AgentAuditLog[]
  aiConfig         UserAIConfig?
  providerConfigs      UserProviderConfig[]
}

// 账本
model AccountBook {
  id          String   @id @default(uuid())
  name        String
  ownerId     String
  owner       User     @relation("BookOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     AccountBookMember[]
  accounts    Account[]
  records     Record[]
  shareCodes  ShareCode[]
  budgets     Budget[]
  recurringTransactions RecurringTransaction[]
  chatSessions         ChatSession[]
  chatMessages         ChatMessage[]
}

// 账本成员
model AccountBookMember {
  id           String      @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  role         String      @default("member")
  joinedAt     DateTime    @default(now())

  @@unique([accountBookId, userId])
}

// 账户
model Account {
  id              String      @id @default(uuid())
  accountBookId   String
  accountBook     AccountBook @relation(fields: [accountBookId], references: [id])
  ownerId         String
  owner           User        @relation(fields: [ownerId], references: [id])
  name            String
  type            String
  currency        String      @default("CNY")
  initialBalance  Float       @default(0)
  balance         Float       @default(0)
  balanceAt       DateTime?
  accountNo       String?
  bankName        String?
  visibility      String      @default("PUBLIC")
  status          String      @default("ACTIVE")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  records              Record[]
  recordsFrom          Record[]    @relation("FromAccount")
  recordsTo            Record[]    @relation("ToAccount")
  adjustments          BalanceAdjustment[]
  recurringTransactions RecurringTransaction[]
  recurringToTransactions RecurringTransaction[] @relation("RecurringToAccount")
}

// 余额调整记录
model BalanceAdjustment {
  id            String   @id @default(uuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date          DateTime
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  remark        String?
  createdAt     DateTime @default(now())
}

// 流水记录
model Record {
  id            String    @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])
  type          String    // INCOME | EXPENSE | TRANSFER
  amount        Float
  date          DateTime
  remark        String?
  tags          String    @default("[]")
  // 账户
  accountId     String    // 主账户（支出账户/收入账户）
  fromAccountId String?   // 转账源账户
  toAccountId   String?   // 转账目标账户
  // 分类
  categoryCode  String?   // 字典中的分类编码，如 餐饮、交通
  // 交易方
  payer         String?   // 交易对方（商家、对方账户名等）
  // 归属人
  ownerId       String    // 实际经手人
  owner         User      @relation(fields: [ownerId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account       Account   @relation(fields: [accountId], references: [id])
  fromAccount   Account?  @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount     Account?  @relation("ToAccount", fields: [toAccountId], references: [id])
  recordAttachments RecordAttachment[]

  @@index([accountBookId, date])
}

// 流水附件
model RecordAttachment {
  id               String   @id @default(uuid())
  recordId         String?  // 关联的流水 ID（创建前为 null）
  path             String   // 文件存储路径
  originalFilename String   // 原始文件名
  createdAt        DateTime @default(now())
  record           Record?  @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

// 系统分类
// 分享码
model ShareCode {
  id           String      @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])
  code         String      @unique
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())
}

// 系统配置
model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String @db.Text
  updatedAt DateTime @updatedAt
}

// 字典
model Dictionary {
  id        String   @id @default(uuid())
  group     String
  code      String
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([group, code])
}

// 节假日
model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique
  name      String
  isWorkday Boolean  @default(false) // true=调休工作日, false=假日
  createdAt DateTime @default(now())
}

// 预算
model Budget {
  id            String      @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  name          String
  type          String      // FIXED | FREE
  year          Int
  month         Int         // 1-12, FREE=0
  amount        Float
  categoryCode  String?     // 固定预算关联字典分类code
  tags          String      @default("[]") // 关联标签 JSON 数组，多标签为或关系
  startDate     DateTime?   // 自由预算统计起始日期（含），为空不限制
  endDate       DateTime?   // 自由预算统计结束日期（含），为空不限制
  remark        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([accountBookId, type, year, month, name])
  @@index([accountBookId, year, month])
}

// 固定收支
model RecurringTransaction {
  id            String   @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  name          String   @default("") // 名称
  type          String   // INCOME | EXPENSE | TRANSFER
  amount        Float    // 单期金额（贷款类型为月还款额）
  remark        String?
  tags          String   @default("[\"固定收支\"]")
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  toAccountId   String?  // 转账目标账户（TRANSFER 类型专用）
  toAccount     Account? @relation("RecurringToAccount", fields: [toAccountId], references: [id])
  categoryCode  String?
  payer         String?
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])

  // 调度
  cron          String   // cron 表达式
  active        Boolean  @default(true)

  // 类型
  recurringType String   // PERIODIC | LOAN

  // 贷款专属
  loanTotalAmount     Float?    // 贷款总额
  loanRemainingAmount Float?    // 剩余本金
  loanInterestRate    Float?    // 年利率(%)
  loanInterestMethod  String?   // EQUAL_INSTALLMENT | EQUAL_PRINCIPAL
  loanStartDate       DateTime? // 贷款开始日期
  loanTermMonths      Int?      // 总期数
  loanMonthlyPayment  Float?    // 月还款额（等额本息自动计算）

  // 生成追踪
  lastGeneratedAt DateTime?
  nextGenerateAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repaymentPlans RepaymentPlan[]
}

// 还款计划
model RepaymentPlan {
  id                       String   @id @default(uuid())
  recurringTransactionId   String
  recurringTransaction     RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)
  period                   Int      // 第几期
  dueDate                  DateTime // 应还日期
  totalPayment             Float    // 月还款额
  principal                Float    // 当月本金
  interest                 Float    // 当月利息
  remainingPrincipal       Float    // 剩余本金
  status                   String   @default("PENDING") // PENDING | GENERATED
  generatedRecordId        String?  // 关联的流水记录 ID

  @@index([recurringTransactionId])
}

// 导入账户映射 — 支持按交易方/商品说明细化条件
model ImportAccountMapping {
  id                  String   @id @default(uuid())
  source              String @db.VarChar(20)   // "alipay" | "wechat" | "csv" | "jd"
  sourceAccountName   String @db.VarChar(100)   // CSV中的原始账户名，如"花呗"
  payerContains       String @db.VarChar(100)   @default("") // 可选：交易方名称包含过滤
  descriptionContains String @db.VarChar(100)   @default("") // 可选：商品说明包含过滤
  targetAccountName   String @db.VarChar(100)   // 目标账户名称，如"支付宝"
  createdAt           DateTime @default(now())

  @@unique([source, sourceAccountName, payerContains, descriptionContains])
}

// 导入分类映射 — 支持按交易方/商品说明细化条件
model ImportCategoryMapping {
  id                  String   @id @default(uuid())
  source              String @db.VarChar(20)   // "alipay" | "wechat" | "csv" | "jd"
  sourceCategory      String @db.VarChar(100)   // CSV中的分类名，如"餐饮美食"
  payerContains       String @db.VarChar(100)   @default("") // 可选：交易方名称包含过滤
  descriptionContains String @db.VarChar(100)   @default("") // 可选：商品说明包含过滤
  recordType          String @db.VarChar(20)   @default("") // INCOME | EXPENSE | TRANSFER，空表示不限类型
  targetCategoryCode  String @db.VarChar(100)   // Dictionary.code，如"餐饮"
  createdAt           DateTime @default(now())

  @@unique([source, sourceCategory, payerContains, descriptionContains, recordType])
}

// API Key
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// AI 聊天会话
model ChatSession {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountBookId String?
  accountBook   AccountBook?  @relation(fields: [accountBookId], references: [id], onDelete: SetNull)
  title         String        @default("新对话")
  summary              String? @db.Text  // 已压缩旧消息的 LLM 摘要
  summaryUpToMessageId String?  // 摘要覆盖到的最后一条消息 ID
  modelProvider String        @default("deepseek")
  modelName     String        @default("deepseek-chat")
  status        String        @default("active")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  messages  ChatMessage[]
  memories  UserMemory[]
  auditLogs AgentAuditLog[]

  @@index([userId, updatedAt])
}

// AI 聊天消息
model ChatMessage {
  id              String       @id @default(uuid())
  sessionId       String
  session         ChatSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  accountBookId   String?
  accountBook     AccountBook? @relation(fields: [accountBookId], references: [id], onDelete: SetNull)
  role            String
  content         String @db.Text
  toolCalls       String? @db.Text
  tokenCount      Int          @default(0)
  modelProvider   String?
  modelName       String?
  parentMessageId String?
  createdAt       DateTime     @default(now())

  @@index([sessionId, createdAt])
}

// AI 长期记忆
model UserMemory {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  content        String @db.Text
  keywords       String?
  memoryType     String       @default("extracted")
  importance     Float        @default(0.5)
  accessCount    Int          @default(0)
  lastAccessedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, memoryType])
  @@index([userId, lastAccessedAt])
}

// AI 审计日志
model AgentAuditLog {
  id            String       @id @default(uuid())
  sessionId     String?
  session       ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  action        String
  toolName      String?
  input         String? @db.Text
  output        String? @db.Text
  modelProvider String?
  modelName     String?
  durationMs    Int?
  status        String       @default("success")
  errorMessage  String?
  ip            String?
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

// AI 助手配置
model UserAIConfig {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled   Boolean  @default(false)

  simpleProviderConfigId  String?
  simpleModel             String  @default("deepseek-chat")
  complexProviderConfigId String?
  complexModel            String  @default("deepseek-reasoner")

  autoConfirmCreate Boolean @default(false)
  language          String  @default("zh-CN")
  temperature       Float   @default(0.7)
  maxTokens         Int     @default(4096)
  maxSteps          Int     @default(10)

  visionProviderConfigId String?
  visionModel            String  @default("")

  disabledTools String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 用户供应商配置
model UserProviderConfig {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   @default("")
  provider    String   // ProviderType
  apiKey      String   @default("")
  baseURL     String   @default("")
  models      String   @default("")
  temperature Float?
  maxTokens   Int?
  contextWindow Int? // 模型上下文窗口大小（token），留空用 provider 默认
  testStatus   String   @default("untested") // untested | pass | fail
  lastTestedAt DateTime?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}