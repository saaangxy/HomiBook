generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  status    String   @default("ACTIVE")
  theme     String   @default("dark")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedBooks           AccountBook[] @relation("BookOwner")
  memberships          AccountBookMember[]
  accounts             Account[]
  records              Record[]
  recurringTransactions RecurringTransaction[]
  apiKeys              ApiKey[]
}

// 账本
model AccountBook {
  id          String   @id @default(uuid())
  name        String
  ownerId     String
  owner       User     @relation("BookOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     AccountBookMember[]
  accounts    Account[]
  records     Record[]
  categories  CategoryMapping[]
  shareCodes  ShareCode[]
  budgets     Budget[]
  recurringTransactions RecurringTransaction[]
}

// 账本成员
model AccountBookMember {
  id           String      @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  role         String      @default("member")
  joinedAt     DateTime    @default(now())

  @@unique([accountBookId, userId])
}

// 账户
model Account {
  id              String      @id @default(uuid())
  accountBookId   String
  accountBook     AccountBook @relation(fields: [accountBookId], references: [id])
  ownerId         String
  owner           User        @relation(fields: [ownerId], references: [id])
  name            String
  type            String
  currency        String      @default("CNY")
  initialBalance  Float       @default(0)
  balance         Float       @default(0)
  balanceAt       DateTime?
  accountNo       String?
  bankName        String?
  visibility      String      @default("PUBLIC")
  status          String      @default("ACTIVE")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  records              Record[]
  recordsFrom          Record[]    @relation("FromAccount")
  recordsTo            Record[]    @relation("ToAccount")
  adjustments          BalanceAdjustment[]
  recurringTransactions RecurringTransaction[]
  recurringToTransactions RecurringTransaction[] @relation("RecurringToAccount")
}

// 余额调整记录
model BalanceAdjustment {
  id            String   @id @default(uuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date          DateTime
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  remark        String?
  createdAt     DateTime @default(now())
}

// 流水记录
model Record {
  id            String    @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])
  type          String    // INCOME | EXPENSE | TRANSFER
  amount        Float
  date          DateTime
  remark        String?
  tags          String    @default("[]")
  // 账户
  accountId     String    // 主账户（支出账户/收入账户）
  fromAccountId String?   // 转账源账户
  toAccountId   String?   // 转账目标账户
  // 分类
  categoryCode  String?   // 字典中的分类编码，如 餐饮、交通
  // 交易方
  payer         String?   // 交易对方（商家、对方账户名等）
  // 归属人
  ownerId       String    // 实际经手人
  owner         User      @relation(fields: [ownerId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account       Account   @relation(fields: [accountId], references: [id])
  fromAccount   Account?  @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount     Account?  @relation("ToAccount", fields: [toAccountId], references: [id])
  recordAttachments RecordAttachment[]

  @@index([accountBookId, date])
}

// 流水附件
model RecordAttachment {
  id               String   @id @default(uuid())
  recordId         String?  // 关联的流水 ID（创建前为 null）
  path             String   // 文件存储路径
  originalFilename String   // 原始文件名
  createdAt        DateTime @default(now())
  record           Record?  @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

// 系统分类
model Category {
  id       String   @id @default(uuid())
  type     String
  name     String   @unique
  icon     String?
  order    Int      @default(0)
  createdAt DateTime @default(now())

  mappings CategoryMapping[]
}

// 分类映射
model CategoryMapping {
  id             String      @id @default(uuid())
  accountBookId  String
  accountBook    AccountBook @relation(fields: [accountBookId], references: [id])
  userCategory   String
  systemCategoryId String
  systemCategory Category    @relation(fields: [systemCategoryId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([accountBookId, userCategory])
}

// 分享码
model ShareCode {
  id           String      @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])
  code         String      @unique
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())
}

// 系统配置
model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// 字典
model Dictionary {
  id        String   @id @default(uuid())
  group     String
  code      String
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([group, code])
}

// 节假日
model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @unique
  name      String
  isWorkday Boolean  @default(false) // true=调休工作日, false=假日
  createdAt DateTime @default(now())
}

// 预算
model Budget {
  id            String      @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  name          String
  type          String      // FIXED | FREE
  year          Int
  month         Int         // 1-12, FREE=0
  amount        Float
  categoryCode  String?     // 固定预算关联字典分类code
  tags          String      @default("[]") // 关联标签 JSON 数组，多标签为或关系
  startDate     DateTime?   // 自由预算统计起始日期（含），为空不限制
  endDate       DateTime?   // 自由预算统计结束日期（含），为空不限制
  remark        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([accountBookId, type, year, month, name])
  @@index([accountBookId, year, month])
}

// 固定收支
model RecurringTransaction {
  id            String   @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id], onDelete: Cascade)
  name          String   @default("") // 名称
  type          String   // INCOME | EXPENSE | TRANSFER
  amount        Float    // 单期金额（贷款类型为月还款额）
  remark        String?
  tags          String   @default("[\"固定收支\"]")
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  toAccountId   String?  // 转账目标账户（TRANSFER 类型专用）
  toAccount     Account? @relation("RecurringToAccount", fields: [toAccountId], references: [id])
  categoryCode  String?
  payer         String?
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])

  // 调度
  cron          String   // cron 表达式
  active        Boolean  @default(true)

  // 类型
  recurringType String   // PERIODIC | LOAN

  // 贷款专属
  loanTotalAmount     Float?    // 贷款总额
  loanRemainingAmount Float?    // 剩余本金
  loanInterestRate    Float?    // 年利率(%)
  loanInterestMethod  String?   // EQUAL_INSTALLMENT | EQUAL_PRINCIPAL
  loanStartDate       DateTime? // 贷款开始日期
  loanTermMonths      Int?      // 总期数
  loanMonthlyPayment  Float?    // 月还款额（等额本息自动计算）

  // 生成追踪
  lastGeneratedAt DateTime?
  nextGenerateAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repaymentPlans RepaymentPlan[]
}

// 还款计划
model RepaymentPlan {
  id                       String   @id @default(uuid())
  recurringTransactionId   String
  recurringTransaction     RecurringTransaction @relation(fields: [recurringTransactionId], references: [id], onDelete: Cascade)
  period                   Int      // 第几期
  dueDate                  DateTime // 应还日期
  totalPayment             Float    // 月还款额
  principal                Float    // 当月本金
  interest                 Float    // 当月利息
  remainingPrincipal       Float    // 剩余本金
  status                   String   @default("PENDING") // PENDING | GENERATED
  generatedRecordId        String?  // 关联的流水记录 ID

  @@index([recurringTransactionId])
}

// API Key
model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prefix     String
  hash       String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}