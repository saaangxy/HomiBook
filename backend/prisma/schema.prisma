generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 用户
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("USER")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedBooks   AccountBook[] @relation("BookOwner")
  memberships  AccountBookMember[]
  accounts     Account[]
  records      Record[]
}

// 账本
model AccountBook {
  id          String   @id @default(uuid())
  name        String
  ownerId     String
  owner       User     @relation("BookOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     AccountBookMember[]
  accounts    Account[]
  records     Record[]
  categories  CategoryMapping[]
  shareCodes  ShareCode[]
}

// 账本成员
model AccountBookMember {
  id           String      @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  role         String      @default("member")
  joinedAt     DateTime    @default(now())

  @@unique([accountBookId, userId])
}

// 账户
model Account {
  id              String      @id @default(uuid())
  accountBookId   String
  accountBook     AccountBook @relation(fields: [accountBookId], references: [id])
  ownerId         String
  owner           User        @relation(fields: [ownerId], references: [id])
  name            String
  type            String
  currency        String      @default("CNY")
  initialBalance  Float       @default(0)
  balance         Float       @default(0)
  balanceAt       DateTime?
  accountNo       String?
  bankName        String?
  visibility      String      @default("PUBLIC")
  status          String      @default("ACTIVE")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  records         Record[]
  recordsFrom     Record[]    @relation("FromAccount")
  recordsTo       Record[]    @relation("ToAccount")
  adjustments     BalanceAdjustment[]
}

// 余额调整记录
model BalanceAdjustment {
  id            String   @id @default(uuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date          DateTime
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  remark        String?
  createdAt     DateTime @default(now())
}

// 流水记录
model Record {
  id            String    @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])
  type          String    // INCOME | EXPENSE | TRANSFER
  amount        Float
  date          DateTime
  remark        String?
  tags          String    @default("[]")
  attachments   String    @default("[]")
  // 账户
  accountId     String    // 主账户（支出账户/收入账户）
  fromAccountId String?   // 转账源账户
  toAccountId   String?   // 转账目标账户
  // 分类
  categoryCode  String?   // 字典中的分类编码，如 餐饮、交通
  // 交易方
  payer         String?   // 交易对方（商家、对方账户名等）
  // 归属人
  ownerId       String    // 实际经手人
  owner         User      @relation(fields: [ownerId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account       Account   @relation(fields: [accountId], references: [id])
  fromAccount   Account?  @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount     Account?  @relation("ToAccount", fields: [toAccountId], references: [id])
}

// 系统分类
model Category {
  id       String   @id @default(uuid())
  type     String
  name     String   @unique
  icon     String?
  order    Int      @default(0)
  createdAt DateTime @default(now())

  mappings CategoryMapping[]
}

// 分类映射
model CategoryMapping {
  id             String      @id @default(uuid())
  accountBookId  String
  accountBook    AccountBook @relation(fields: [accountBookId], references: [id])
  userCategory   String
  systemCategoryId String
  systemCategory Category    @relation(fields: [systemCategoryId], references: [id])
  createdAt     DateTime    @default(now())

  @@unique([accountBookId, userCategory])
}

// 分享码
model ShareCode {
  id           String      @id @default(uuid())
  accountBookId String
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])
  code         String      @unique
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())
}

// 系统配置
model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// 字典
model Dictionary {
  id        String   @id @default(uuid())
  group     String
  code      String
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([group, code])
}