{
  "name": "homibook-backend",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prebuild": "node prisma/generate-all.mjs",
    "db:generate": "node prisma/generate-all.mjs",
    "db:migrate": "node prisma/run.mjs migrate dev",
    "db:migrate:all": "node prisma/migrate-all.mjs",
    "db:deploy": "node prisma/run.mjs migrate deploy",
    "db:push": "node prisma/run.mjs db push"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/openai": "^3.0.73",
    "@fastify/cors": "^8.5.0",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^6.0.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@scalar/fastify-api-reference": "^1.58.0",
    "ai": "^6.0.208",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cron-parser": "^5.5.0",
    "csv-parse": "^6.2.1",
    "fastify": "^4.29.1",
    "iconv-lite": "^0.7.2",
    "node-cron": "^4.2.1",
    "prisma": "^7.9.1",
    "puppeteer": "^25.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
